{
  "name": "aithya-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write eslint.config.js server/http.mjs server/quota.mjs server/github.mjs src/studio-ui.js src/wizard-policy.js tests/*.test.mjs tests/workspace-smoke.mjs",
    "test:browser": "node tests/workspace-smoke.mjs",
    "check:server": "node --check dist/server/index.js",
    "build:static": "npm run build && node vercel-build.mjs",
    "dev": "npm run build:static && node scripts/serve-portal.mjs",
    "typecheck": "tsc -p tsconfig.portal.json",
    "lint:unused": "oxlint -D no-unused-vars -A react/only-export-components src/portal scripts/serve-portal.mjs server/project-usage.mjs && knip --include files,dependencies"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "pdfjs-dist": "6.5.438",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "knip": "6.48.0",
    "oxlint": "1.95.0",
    "playwright": "1.60.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
